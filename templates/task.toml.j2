schema_version = "1.4"

[task]
name = "{{ org_name }}/{{ task_name }}"
version = "1.0.0"
description = {{ description | tojson }}
authors = []
keywords = [{{ keywords | join(', ') }}]

[metadata]
difficulty_explanation = {{ difficulty_explanation | tojson }}
category = "machine-learning"

[verifier]
environment_mode = "separate"
timeout_sec = 300.0
user = "root"

[agent]
timeout_sec = 900.0
user = "agent"

[environment]
network_mode = "public"
build_timeout_sec = 600.0
os = "linux"
cpus = 2
memory_mb = 2048
storage_mb = 10240
gpus = 0
gpu_types = ["H100", "A100"]

[verifier.environment]
cpus = 2
memory_mb = 1024
