FROM ghcr.io/astral-sh/uv:trixie-slim

ENV UV_PROJECT_ENVIRONMENT="/usr/local"

RUN useradd -ms /bin/bash agent
USER agent
WORKDIR /home/agent
COPY data.py data.py
COPY data_requirements.txt data_requirements.txt
RUN uv venv --system
RUN uv pip install -r data_requirements.txt

{% if test %}

ARG ALPACA_API_KEY
ENV ALPACA_API_KEY=$ALPACA_API_KEY

ARG ALPACA_SECRET_KEY
ENV ALPACA_SECRET_KEY=$ALPACA_SECRET_KEY

ARG KAGGLE_API_TOKEN
ENV KAGGLE_API_TOKEN=$KAGGLE_API_TOKEN

RUN uv run data.py

{% else %}

# Load secret data environment variables and run data retrieval script
RUN --mount=type=secret,id=alpaca_api_key,env=ALPACA_API_KEY \
    --mount=type=secret,id=alpaca_secret_key,env=ALPACA_SECRET_KEY \
    --mount=type=secret,id=kaggle_api_token,env=KAGGLE_API_TOKEN \
    uv run data.py

{% endif %}

RUN rm data.py
RUN rm data_requirements.txt
